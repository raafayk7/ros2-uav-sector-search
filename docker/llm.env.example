# docker/llm.env.example
# API keys for the language prior's live provider. Only a live call needs one;
# replay (the default, and CI) needs none.
#
#   cp docker/llm.env.example docker/llm.env && chmod 600 docker/llm.env
#
# docker/llm.env is gitignored and dockerignored. Compose does not read it:
# give it to one command with `docker exec --env-file` (run from the repo root)
#
#   docker exec --env-file docker/llm.env -it multi-agent-uavs bash -l
#
# The model name picks the provider and so the key (gemini-* / claude-*); each
# key is only ever sent to its own vendor. No quotes and no spaces around the
# value: --env-file takes everything after the = as it is.

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
