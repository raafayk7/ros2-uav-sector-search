# docker/.env.example
# Copy to docker/.env and edit if your host UID/GID isn't 1000:1000.
# Check with: `id -u` and `id -g` on the host.

# Match host user so bind-mounted files aren't root-owned
UID=1000
GID=1000

# ROS 2 DDS domain. Keep at 0 unless you're running multiple ROS 2 graphs
# on the same network and want to isolate them. Same value must be set
# on every node (in or out of the container) that should see each other.
ROS_DOMAIN_ID=0

# Force software rendering if Gazebo crashes on your iGPU (try 1 only if
# /dev/dri passthrough isn't working).
LIBGL_ALWAYS_SOFTWARE=0
